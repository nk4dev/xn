{
  "tokenizer": "bpe",
  "vocab_size": 1024,
  "block_size": 128,
  "n_layer": 4,
  "n_head": 4,
  "n_embd": 128,
  "dropout": 0.1,
  "content_loader": {
    "separator": "\n\n",
    "sources": [
      {
        "path": "data/*.txt",
        "format": "text"
      }
    ]
  },
  "out_dir": "runs/default",
  "batch_size": 16,
  "max_steps": 1000,
  "lr": 0.0003,
  "min_lr": 3e-05,
  "warmup_steps": 100,
  "weight_decay": 0.1,
  "val_fraction": 0.1,
  "eval_interval": 100,
  "eval_steps": 20,
  "seed": 1337,
  "device": "cpu"
}