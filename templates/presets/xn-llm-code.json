{
  "tokenizer": "bpe",
  "vocab_size": 2048,
  "block_size": 256,
  "n_layer": 4,
  "n_head": 4,
  "n_embd": 128,
  "dropout": 0.1,
  "content_loader": {
    "separator": "\n\n",
    "sources": [
      {
        "path": "data/**/*.js",
        "format": "text"
      },
      {
        "path": "data/**/*.ts",
        "format": "text"
      }
    ]
  },
  "out_dir": "runs/xn-llm-code",
  "batch_size": 32,
  "max_steps": 6000,
  "lr": 0.001,
  "min_lr": 0.0001,
  "warmup_steps": 200,
  "weight_decay": 0.1,
  "val_fraction": 0.1,
  "eval_interval": 250,
  "eval_steps": 20,
  "seed": 1337,
  "device": "auto"
}